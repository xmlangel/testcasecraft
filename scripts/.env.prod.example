# ===================================
# Production Environment Configuration
# ===================================
# 이 파일을 .env.prod로 복사하고 실제 값으로 수정하세요
# cp .env.prod.example .env.prod

# ===================================
# Domain & SSL Configuration
# ===================================
# 메인 도메인 (필수)
DOMAIN_NAME=localhost
# 추가 도메인 (선택적, 공백으로 구분)
EXTRA_DOMAINS=
# HTTPS 활성화 (true/false)
ENABLE_HTTPS=false
# Let's Encrypt 이메일 (HTTPS 사용시 필수)
CERTBOT_EMAIL=
# 추가 도메인 인증서 (선택적)
CERTBOT_EXTRA_DOMAINS=

# ===================================
# Database Configuration
# ===================================
POSTGRES_DB=testcase_management
POSTGRES_USER=testcase_user
# 생성: openssl rand -base64 24
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_PORT=5432


# ===================================
# Application Security
# ===================================
# 아래 값은 전부 배포 환경마다 새로 만들어 넣는다. 예시 값을 그대로 쓰면
# 앱이 기동 시 경고/거부한다 (DefaultConfigurationWarning).
#
# JWT Secret — HS512 라서 512비트 이상, Base64 인코딩 필수
# 생성: openssl rand -base64 64
JWT_SECRET=__CHANGE_ME__
# JIRA 암호화 키 — AES-256, 32바이트 Base64
# 생성: openssl rand -base64 32
JIRA_ENCRYPTION_KEY=__CHANGE_ME__

# ===================================
# File Upload Configuration
# ===================================
# 업로드 경로 (컨테이너 내부 경로)
UPLOAD_PATH=/app/uploads
# 최대 업로드 크기 (Nginx와 일치해야 함)
MAX_UPLOAD_SIZE=100MB

# ===================================
# Monitoring & Logging
# ===================================
# 로그 레벨 (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL=INFO
# 액세스 로그 활성화
ENABLE_ACCESS_LOG=true
# 액추에이터 설정
MANAGEMENT_ENDPOINT_HEALTH_SHOW_COMPONENTS=NEVER
# CORS 설정 (Nginx 리버스 프록시 고려)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080

# ===================================
# Performance Settings
# ===================================
# JVM 힙 메모리 설정
JAVA_OPTS="-Xmx2g -Xms1g"
# 데이터베이스 연결 풀 크기
DB_POOL_SIZE=20
